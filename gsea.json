osition":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Command Interface","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qrKKchwxxV"}],"identifier":"command-interface","label":"Command Interface","html_id":"command-interface","implicit":true,"key":"LEisidcIP5"}],"identifier":"11b068e8","html_id":"11b068e8","key":"eW27LIVQYX"},{"type":"block","kind":"notebook-code","data":{"kernel":"Bash"},"children":[{"type":"code","lang":"sos","executable":true,"value":"sos run pipeline/gsea.ipynb -h","key":"oQ3Y68d8QR"},{"type":"outputs","id":"y2-vJ7--ZhuT9-kH2C61P","children":[],"key":"uMqBbVycbn"}],"identifier":"dbd07121","html_id":"dbd07121","key":"WpTUnWMsQp"},{"type":"block","kind":"notebook-content","children":[{"type":"code","lang":"","value":"usage: sos run code/SoS/enrichment/gsea.ipynb\n               [workflow_name | -t targets] [options] [workflow_options]\n  workflow_name:        Single or combined workflows defined in this script\n  targets:              One or more targets to generate\n  options:              Single-hyphen sos parameters (see \"sos run -h\" for details)\n  workflow_options:     Double-hyphen workflow-specific parameters\n\nWorkflows:\n  pathway_analysis\n\nGlobal Workflow Options:\n  --cwd output (as path)\n                        Path to the work directory of the analysis.\n  --modular-script-dir code/script (as path)\n  --genes-file . (as path)\n  --name VAL (as str, required)\n  --numThreads 8 (as int)\n                        Number of threads\n  --job-size 1 (as int)\n                        For cluster jobs, number commands to run per job\n  --walltime 12h\n  --mem 16G\n\nSections\n  pathway_analysis:\n    Workflow Options:\n      --pvalue-cutoff 1 (as int)\n      --organism hsa","position":{"start":{"line":1,"column":1},"end":{"line":30,"column":1}},"key":"nuRL4jybSA"}],"identifier":"4ee233b8","html_id":"4ee233b8","key":"AYzYJU5RTD"},{"type":"block","kind":"notebook-content","data":{"kernel":"SoS"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Workflow implementation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LPdx4Qqk6W"}],"identifier":"workflow-implementation","label":"Workflow implementation","html_id":"workflow-implementation","implicit":true,"key":"HLdVnVqGmG"}],"identifier":"7d2556a5","html_id":"7d2556a5","key":"uVkud1z3j2"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[global]\n# Path to the work directory of the analysis.\nparameter: cwd = path('output')\nparameter: modular_script_dir = path('code/script')  # override with --modular-script-dir\n\nparameter: genes_file = path()  # TSV file with columns: group, gene_id\nparameter: name = str\n# Number of threads\nparameter: numThreads = 8\n# For cluster jobs, number commands to run per job\nparameter: job_size = 1\nparameter: walltime = '12h'\nparameter: mem = '16G'","key":"kwgFWNjlEi"},{"type":"outputs","id":"fulOjsspqSVrzlrkd6l_4","children":[],"key":"qEFsvV9dn7"}],"identifier":"f4d94e45","html_id":"f4d94e45","key":"NO9GxbLKLA"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[pathway_analysis]\nparameter: pvalue_cutoff = 1\nparameter: organism = 'hsa'\noutput: pathway_results = f'{cwd:a}/{step_name}/{name}.combined_pathway_results.rds'\n\ntask: trunk_workers = 1, trunk_size = job_size, walltime = walltime, mem = mem, cores = numThreads, tags = f'{step_name}_{_output[0]:bnn}'\nbash: expand = '${ }', stderr = f'{_output[0]}.stderr', stdout = f'{_output[0]}.stdout'\n    Rscript ${modular_script_dir}/enrichment/gsea.R \\\n        --genes-file ${genes_file} \\\n        --organism ${organism} \\\n        --pvalue-cutoff ${pvalue_cutoff} \\\n        --output ${_output['pathway_results']}","key":"DXC6tfJi9B"},{"type":"outputs","id":"-MKxWUmFInLJwz6FH1lrh","children":[],"key":"hQv4Y9L3Ec"}],"identifier":"d4d026bb","html_id":"d4d026bb","key":"tHowMMkNkW"}],"key":"wtKFblKHmM"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Chromosome-Specific Enrichment Analysis of Annotations Using Block Jackknife","url":"/eoo-enrichment","group":"Enrichment and Validation"},"next":{"title":"GREGOR enrichment analysis","url":"/gregor","group":"Enrichment and Validation"}}},"domain":"http://pre.render"}