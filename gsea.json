ook-content","data":{"kernel":"SoS"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Workflow implementation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZjwlvHC5bu"}],"identifier":"workflow-implementation","label":"Workflow implementation","html_id":"workflow-implementation","implicit":true,"key":"hvhJONMKwU"}],"identifier":"7d2556a5","html_id":"7d2556a5","key":"byXCRLXelS"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[global]\n# Path to the work directory of the analysis.\nparameter: cwd = path('output')\nparameter: modular_script_dir = path('code/script')  # override with --modular-script-dir\n\nparameter: genes_file = path()  # TSV file with columns: group, gene_id\nparameter: name = str\n# Number of threads\nparameter: numThreads = 8\n# For cluster jobs, number commands to run per job\nparameter: job_size = 1\nparameter: walltime = '12h'\nparameter: mem = '16G'","key":"QpjYfWcj3M"},{"type":"outputs","id":"65Af6mbYFOpA124EyY0KW","children":[],"key":"k6KoQrFFm0"}],"identifier":"f4d94e45","html_id":"f4d94e45","key":"kZmb9iy4Qs"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[pathway_analysis]\nparameter: pvalue_cutoff = 1\nparameter: organism = 'hsa'\noutput: pathway_results = f'{cwd:a}/{step_name}/{name}.combined_pathway_results.rds'\n\ntask: trunk_workers = 1, trunk_size = job_size, walltime = walltime, mem = mem, cores = numThreads, tags = f'{step_name}_{_output[0]:bnn}'\nbash: expand = '${ }', stderr = f'{_output[0]}.stderr', stdout = f'{_output[0]}.stdout'\n    Rscript ${modular_script_dir}/enrichment/gsea.R \\\n        --genes-file ${genes_file} \\\n        --organism ${organism} \\\n        --pvalue-cutoff ${pvalue_cutoff} \\\n        --output ${_output['pathway_results']}","key":"WarMtD3yfm"},{"type":"outputs","id":"z2wD_9tGPkCG_pqUkyw5d","children":[],"key":"d23lqBMHNE"}],"identifier":"d4d026bb","html_id":"d4d026bb","key":"dobwElgtq8"}],"key":"z6PPXorKq3"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Chromosome-Specific Enrichment Analysis of Annotations Using Block Jackknife","url":"/eoo-enrichment","group":"Enrichment and Validation"},"next":{"title":"GREGOR enrichment analysis","url":"/gregor","group":"Enrichment and Validation"}}},"domain":"http://pre.render"}