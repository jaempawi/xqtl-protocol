(see \"sos run -h\" for details)\n  workflow_options:     Double-hyphen workflow-specific parameters\n\nWorkflows:\n  default\n\nGlobal Workflow Options:\n  --cwd . (as path)\n  --modular-script-dir VAL (as path, required)\n                        code/script dir that holds the pecotmr_integration\n                        wrappers\n  --output-dir VAL (as path, required)\n  --sub-dir . (as path)\n  --study study\n                        labels for the assembled QtlSumStats\n  --context context\n  --genome hg38\n  --maf-cutoff 0.01 (as float)\n  --cis-window 1000000 (as int)\n  --af-col af\n  --pvalue-col pvalue\n  --molecular-id-col 'molecular_trait_object_id'\n  --pvalue-cutoff 0.05 (as float)\n                        drop pairs with p above this before assembling (keeps\n                        the object small; the per-gene min variant is always\n                        retained so the Bonferroni min is exact)\n  --fdr-threshold 0.05 (as float)\n  --regional-pattern 'cis_qtl[.]regional[.]tsv[.]gz$'\n                        list.files() regex patterns to locate the inputs in the\n                        work dir\n  --qtl-pattern 'cis_qtl[.]pairs[.]tsv[.]gz$'\n  --n-variants-suffix 'cis_n_variants_stats[.]tsv[.]gz$'\n  --[no-]enable-archive (default to False)\n\nSections\n  default:","position":{"start":{"line":1,"column":1},"end":{"line":42,"column":1}},"key":"haOI21T3Af"}],"identifier":"239519a1","html_id":"239519a1","key":"d3Ij3vZjZd"},{"type":"block","kind":"notebook-content","data":{"kernel":"SoS"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Workflow implementation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gN28mZPMKa"}],"identifier":"workflow-implementation","label":"Workflow implementation","html_id":"workflow-implementation","implicit":true,"key":"D1VJOmt3Y0"},{"type":"paragraph","position":{"start":{"line":3,"column":1},