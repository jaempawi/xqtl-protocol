numThreads}\n","key":"zK0n1GTsyy"},{"type":"outputs","id":"jSiH0nih8YTzekTRCyNpH","children":[],"key":"fqp1Y4soU3"}],"identifier":"1472106b","html_id":"1472106b","key":"VSveHbYD8D"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"b2diw3yp6X"},{"type":"outputs","id":"nv3YvwS7u7ai0BjRmezmb","children":[],"key":"ENEkx3WnCb"}],"identifier":"69592b8a","html_id":"69592b8a","key":"M8w8JibkYC"}],"key":"kAmmjtzGhb"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://pre.render"}