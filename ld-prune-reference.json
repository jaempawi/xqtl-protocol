numThreads}\n","key":"OM2MWF0Hic"},{"type":"outputs","id":"GeXXomPr2O1A2A9_iA_at","children":[],"key":"QmsiaRQ95J"}],"identifier":"1472106b","html_id":"1472106b","key":"LwcEespcax"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"zeNuJVKvkD"},{"type":"outputs","id":"26UXrHpRMJ_jyk0fozcKT","children":[],"key":"fgFeydOFPC"}],"identifier":"69592b8a","html_id":"69592b8a","key":"bgnIOoww6J"}],"key":"egXCcNSY9E"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://pre.render"}