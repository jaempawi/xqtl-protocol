numThreads}\n","key":"XX91qUOojh"},{"type":"outputs","id":"Gz01CHLL3MfOc1W0Kk-L3","children":[],"key":"mGk2Nh2yMv"}],"identifier":"1472106b","html_id":"1472106b","key":"cA81RjY6WP"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"C0j3clWx24"},{"type":"outputs","id":"DP3iwvhYmUbuzu7VkyRHL","children":[],"key":"eVjV8PEfyX"}],"identifier":"69592b8a","html_id":"69592b8a","key":"rRNAM4EKOU"}],"key":"bKLP6Ty7Ei"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://pre.render"}