numThreads}\n","key":"mVXWBHp4AM"},{"type":"outputs","id":"rpz5SloP0jXvmSLCP5DAD","children":[],"key":"FfaSLzDXkH"}],"identifier":"1472106b","html_id":"1472106b","key":"CcECBuPDDY"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"MbDoo8YYKI"},{"type":"outputs","id":"AB-VLjG7H7meyIfL-nX49","children":[],"key":"dCAVgY9qVj"}],"identifier":"69592b8a","html_id":"69592b8a","key":"KukWUrpbjv"}],"key":"uRd4NMEGDI"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://pre.render"}