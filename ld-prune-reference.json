numThreads}\n","key":"dixh1cL9aM"},{"type":"outputs","id":"1bs8iblj7p3SsdPW9UJGI","children":[],"key":"OijdWWfUBY"}],"identifier":"1472106b","html_id":"1472106b","key":"NXnEY91Y2u"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"f5oWsz25RA"},{"type":"outputs","id":"qLV7UWjnsdX9nrgdCrdCc","children":[],"key":"dY9sxBVfbX"}],"identifier":"69592b8a","html_id":"69592b8a","key":"x1CAIFwm00"}],"key":"Lf6Eqyr6Su"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://pre.render"}