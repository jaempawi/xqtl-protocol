numThreads}\n","key":"RGOsF91jq8"},{"type":"outputs","id":"jvrzqPzJiRtvRB4ghQd40","children":[],"key":"s9AyZWprGT"}],"identifier":"1472106b","html_id":"1472106b","key":"Q1jfXUIFIV"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"hHjaf9g02C"},{"type":"outputs","id":"RC1QHOZ8_zmBeit1AEtSp","children":[],"key":"eSTnsr06Ag"}],"identifier":"69592b8a","html_id":"69592b8a","key":"IWl3FvQF8z"}],"key":"jxszr9OX2a"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://pre.render"}